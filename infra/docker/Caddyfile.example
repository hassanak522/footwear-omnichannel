# Replace these domains and connect Caddy to the Compose edge network.
# Public 80/443 ports belong to the reverse proxy, not the API or PostgreSQL.
shop.example.com {
  encode zstd gzip
  reverse_proxy web:3000
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }
}
api.example.com {
  encode zstd gzip
  reverse_proxy api:3001
  header {
    X-Content-Type-Options nosniff
    Referrer-Policy strict-origin-when-cross-origin
    Strict-Transport-Security "max-age=31536000; includeSubDomains"
  }
}
