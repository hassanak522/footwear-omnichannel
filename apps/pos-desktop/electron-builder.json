{
  "appId": "pk.royalstep.pos",
  "productName": "Royal Step POS",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "electron/main.cjs",
    "electron/preload.cjs",
    "package.json"
  ],
  "asar": true,
  "win": {
    "target": [
      {
        "target": "nsis",
        "arch": ["x64"]
      }
    ]
  },
  "nsis": {
    "oneClick": false,
    "perMachine": false,
    "allowElevation": true,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "createStartMenuShortcut": true,
    "shortcutName": "Royal Step POS",
    "deleteAppDataOnUninstall": false,
    "artifactName": "RoyalStep-POS-Setup-${version}.${ext}"
  }
}
